# Browser-safe configuration. Vite includes VITE_* values in the client bundle.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
VITE_APP_URL=http://localhost:5173
VITE_APP_ENV=local

# Server-only configuration for Vercel Functions. Never add a VITE_ prefix.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_me
APP_ENV=local
APP_URL=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173

# Durable AI-review worker. AI_REVIEW_ADAPTER=mock is supported only outside
# production; production AI remains disabled until an approved provider is added.
CRON_SECRET=replace-with-a-long-random-secret
AI_REVIEW_ADAPTER=disabled
AI_REVIEW_MOCK_SCENARIO=PASS

# Required only for production invitation delivery. Local/development captures
# invitations and returns a preview link to an authenticated FSP administrator.
RESEND_API_KEY=re_replace_me
EMAIL_FROM=FSP Compliance <invites@example.com>
